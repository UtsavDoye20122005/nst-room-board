# ============================================================
#  Copy this file to .env.local and fill in the real values.
#  .env.local is git-ignored - never commit it.
#  Every value here is also set in Vercel under
#  Project -> Settings -> Environment Variables.
# ============================================================

# ---------- 1. Firebase web app (Project settings -> Your apps) ----------
# These are PUBLIC by design. Firestore security rules are what protect data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- 2. Who is allowed in ----------
# Comma separated. Only these email domains can sign in.
# Leave blank to allow any email (not recommended).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=newtonschool.co,rishihood.edu.in

# Which of the domains above means faculty, which means student.
# The onboarding screen detects the role from the email and locks it -
# nobody picks their own role, so nobody can pick the wrong one.
# Leave both blank to fall back to asking (a manual Faculty/Student choice).
NEXT_PUBLIC_FACULTY_EMAIL_DOMAINS=newtonschool.co
NEXT_PUBLIC_STUDENT_EMAIL_DOMAINS=rishihood.edu.in

# Not automatic - nobody can self-promote to admin from the browser, by
# design. This is just the default email that `npm run make-admin`
# promotes when you run it with no argument, so you don't retype it.
# You still run that script once, after your first sign-in.
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAIL=

# ---------- 3. Firebase Admin (server side, for /api/notify) ----------
# Project settings -> Service accounts -> Generate new private key.
# Open the downloaded JSON and copy the three values across.
# For FIREBASE_PRIVATE_KEY keep the \n escapes and wrap in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ---------- 4. Email ----------
# console = no mail sent, notification is printed to the server log.
#           Use this while developing. Nothing breaks.
# gmail   = your Gmail account + a 16-character App Password. Free, ~500/day.
# brevo   = Brevo (ex-Sendinblue) API. Free 300/day, no domain needed.
EMAIL_PROVIDER=console

EMAIL_FROM_NAME="NST Room Board"
EMAIL_FROM_ADDRESS=

# only for EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=

# only for EMAIL_PROVIDER=brevo
BREVO_API_KEY=
