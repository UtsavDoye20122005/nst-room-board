rules_version = '2';

// ============================================================
//  NST Room Board - Firestore security rules
//
//  Deploy with:  firebase deploy --only firestore:rules
//  Or paste into Firebase console -> Firestore -> Rules -> Publish.
//
//  EDIT ONE THING: the allowedDomain() list below must match your
//  college email domains.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function allowedDomain() {
      // Students have no login at all anymore - they hear about
      // room/time changes on Slack instead of signing in here.
      // Teachers sign in with their real college address only.
      // The old rule also trusted the ENTIRE @gmail.com domain (so
      // literally any Gmail account could sign in and self-create a
      // faculty profile below) - that's gone. Exactly one Gmail
      // address is trusted now: the shared admin account.
      return request.auth != null
        && request.auth.token.email != null
        && (
             request.auth.token.email.matches('.*@newtonschool[.]co')             // teachers - college address
          || request.auth.token.email == 'nstroomboard@gmail.com'                 // admin - one exact address, not a whole domain
          || request.auth.token.email.matches('.*@nst-room-board[.]internal')     // admin/teacher ID+password login (see scripts/createAdminLogin.mjs, createTeacherLogin.mjs) - not a real inbox, exact made-up domain only
        );
    }

    function signedIn() {
      return allowedDomain();
    }

    // A teacher marking THEMSELVES present, and only:
    //   - on their own duty,
    //   - as present (or clearing it) - never absent, that is the
    //     exam office's word, not theirs,
    //   - while the exam is starting: from the start time until
    //     30 minutes later. Older duties have no startsAt, so those
    //     fall back to the screen's own check.
    function isMyAttendance() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['present', 'markedAt', 'markedBy', 'updatedAt'])
        && resource.data.email == request.auth.token.email.lower()
        && request.resource.data.present != false
        && (
             !('startsAt' in resource.data) || resource.data.startsAt == null
             || (
                  request.time.toMillis() >= resource.data.startsAt
                  && request.time.toMillis() <= resource.data.startsAt + 1800000
                )
           );
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myProfile().role
        : 'none';
    }

    function isAdmin()   { return myRole() == 'admin'; }
    function canBook()   { return myRole() == 'faculty' || myRole() == 'admin'; }

    // ---------- users ----------
    // Everyone signed in can read profiles (needed to show teacher names).
    // You may only write your own profile, and you may not make yourself
    // an admin or hand yourself faculty rights - an admin does that.
    match /users/{uid} {
      // You can always read yourself. Staff can read everyone, because the
      // Admin -> People screen needs it. Students cannot read other
      // students - a booking already carries the teacher's name, so the
      // board never needs the users collection.
      allow read: if signedIn() && (
           request.auth.uid == uid
        || myRole() == 'faculty'
        || isAdmin()
      );

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['faculty', 'student'];

      allow update: if signedIn() && (
           isAdmin()
        || ( request.auth.uid == uid
             && request.resource.data.role == resource.data.role
             && request.resource.data.email == resource.data.email )
      );

      allow delete: if isAdmin();
    }

    // ---------- rooms / batches / config ----------
    // Read by anyone signed in, changed only by an admin.
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /batches/{batchId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- bookings ----------
    // Anyone signed in can see the board.
    // Faculty create their own bookings; only the owner or an admin
    // may change or remove one.
    // A teacher's own booking must be created unapproved - only an
    // admin signs it off, and only an admin may ever flip `approved`
    // afterwards. Everything else about a booking stays editable by
    // its owner (moving rooms, cancelling), so the rule below pins
    // that one field rather than freezing the whole document.
    match /bookings/{bookingId} {
      allow read: if signedIn();

      allow create: if canBook()
        && ( request.resource.data.facultyUid == request.auth.uid || isAdmin() )
        && request.resource.data.status == 'confirmed'
        && ( isAdmin() || request.resource.data.approved == false );

      allow update, delete: if canBook()
        && ( resource.data.facultyUid == request.auth.uid || isAdmin() )
        && ( isAdmin() || request.resource.data.approved == resource.data.approved );
    }

    // ---------- slotLocks ----------
    // One document per occupied hour, id = <date>_<roomId>_<slot>.
    // Its existence IS the booking conflict guard, so creation must be
    // done inside a transaction by the app. Only faculty touch these.
    match /slotLocks/{lockId} {
      allow read: if signedIn();
      allow create: if canBook()
        && ( request.resource.data.facultyUid == request.auth.uid || isAdmin() );
      allow update, delete: if canBook()
        && ( resource.data.facultyUid == request.auth.uid || isAdmin() );
    }

    // ---------- notices ----------
    // Append-only history. Faculty write, everyone reads, admin prunes.
    match /notices/{noticeId} {
      allow read: if signedIn();
      allow create: if canBook();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- roster ----------
    // Pre-loaded student rows (email -> year/batch, name once it's
    // added), read once by onboarding so a student never has to pick
    // their own batch wrong. Everyone else can only read their OWN row -
    // the same email-ownership check used everywhere else. Admin can
    // additionally read every row, for the "who's in this batch" list
    // on Admin -> Batches. Only an admin (via the seed script's Admin
    // SDK, which bypasses this entirely) ever writes it.
    match /roster/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }

    // ---------- otpCodes ----------
    // The one-time login codes from /api/auth/request-code. Nobody signs
    // in yet when one of these matters, so no client rule could check who
    // "owns" a code anyway - only the server (Admin SDK, which ignores
    // these rules entirely) is ever allowed to touch this collection.
    match /otpCodes/{email} {
      allow read, write: if false;
    }
  
    // ---------- invigilation ----------
    // Everything here is staff-only. Students cannot read a single
    // document in these four collections.
    //
    // Why teachers may write and not only read: a teacher dropping a
    // duty has to hand it to somebody else in the same moment (a new
    // duty document) and move the two counters. Doing that from the
    // browser keeps the app free of a server, and every one of those
    // actions writes a line to invigLog, which only an admin can read.
    // Nobody can quietly delete a duty: deleting is admin-only.

    match /invigilators/{email} {
      allow read: if canBook();
      // A teacher may only move the counters (their own draw maths),
      // never rename somebody or switch them off.
      allow update: if isAdmin() || (
        canBook()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['duties', 'skips', 'lastDutyDate', 'updatedAt'])
      );
      allow create, delete: if isAdmin();
    }

    match /examDays/{dayId} {
      allow read: if canBook();
      allow write: if isAdmin();
    }

    match /duties/{dutyId} {
      allow read: if canBook();
      // Create covers the replacement a skip hands over. The fields
      // that say WHO and WHEN cannot be edited afterwards.
      allow create: if canBook();
      // Two separate doors for a teacher.
      //
      // 1. Attendance, on your OWN duty only. Nobody can mark a
      //    colleague present or absent - only the exam office can.
      //    This stays open even for a fixed pair, otherwise two
      //    teachers who agreed to share a room could never say
      //    "I'm here".
      // 2. Everything else - dropping out, asking for a partner,
      //    accepting one, and the room swap that acceptance causes.
      //    That last one touches somebody else's duty on purpose,
      //    so it is not limited to your own document, but a pair
      //    both teachers agreed to is fixed: from then on only an
      //    admin can move either of them.
      allow update: if isAdmin()
        || (canBook() && isMyAttendance())
        || (
             canBook()
             && resource.data.partnerLocked != true
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'skipReason', 'skipAt', 'partnerRequestTo', 'partnerRequestAt',
                            'partnerLocked', 'partnerName', 'pairAgain',
                            'swapWantEmail', 'swapWantName', 'swapOutEmail', 'swapOutName', 'swapAt',
                            'roomId', 'roomName', 'updatedAt'])
           );
      allow delete: if isAdmin();
    }

    match /invigLog/{entryId} {
      allow read: if isAdmin();
      allow create: if canBook();
      allow update, delete: if false;   // append only
    }

}
}
