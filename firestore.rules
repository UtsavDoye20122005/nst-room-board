rules_version = '2';

// ============================================================
//  NST Room Board - Firestore security rules
//
//  Deploy with:  firebase deploy --only firestore:rules
//  Or paste into Firebase console -> Firestore -> Rules -> Publish.
//
//  EDIT ONE THING: the allowedDomain() list below must match your
//  college email domains.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function allowedDomain() {
      // Students have no login at all anymore - they hear about
      // room/time changes on Slack instead of signing in here.
      // Teachers sign in with their real college address only.
      // The old rule also trusted the ENTIRE @gmail.com domain (so
      // literally any Gmail account could sign in and self-create a
      // faculty profile below) - that's gone. Exactly one Gmail
      // address is trusted now: the shared admin account.
      return request.auth != null
        && request.auth.token.email != null
        && (
             request.auth.token.email.matches('.*@newtonschool[.]co')             // teachers - college address
          || request.auth.token.email == 'nstroomboard@gmail.com'                 // admin - one exact address, not a whole domain
          || request.auth.token.email.matches('.*@nst-room-board[.]internal')     // admin/teacher ID+password login (see scripts/createAdminLogin.mjs, createTeacherLogin.mjs) - not a real inbox, exact made-up domain only
        );
    }

    function signedIn() {
      return allowedDomain();
    }

    // A teacher marking THEMSELVES present, and only:
    //   - on their own duty,
    //   - as present (or clearing it) - never absent, that is the
    //     exam office's word, not theirs,
    //   - while the exam is starting: from the start time until
    //     30 minutes later. Older duties have no startsAt, so those
    //     fall back to the screen's own check.
    // Everything a teacher does to THEIR OWN duty: drop it, ask for a
    // partner, answer the pairing question, ask the office for a swap.
    function isMyOwnDuty() {
      return resource.data.email == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'skipReason', 'skipAt', 'partnerRequestTo', 'partnerRequestAt',
                       'partnerLocked', 'partnerName', 'partnerEmail', 'pairAgain',
                       'swapWantEmail', 'swapWantName', 'swapOutEmail', 'swapOutName', 'swapAt',
                       'roomId', 'roomName', 'updatedAt'])
        // Dropping a duty yourself is only free more than 24 hours
        // out. Nearer than that it is the exam office's decision, and
        // the status they write is 'skipped', not this.
        && (
             request.resource.data.status != 'skipped'
             || resource.data.status == 'skipped'
             || !('startsAt' in resource.data) || resource.data.startsAt == null
             || request.time.toMillis() < resource.data.startsAt - 86400000
           );
    }

    // Answering somebody who asked ME to sit with them: I may accept
    // (which moves them into my room and fixes the pair) or refuse.
    // Only ever the person who actually asked me.
    function isAnswerToMyAsker() {
      return resource.data.partnerRequestTo == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['roomId', 'roomName', 'partnerRequestTo', 'partnerRequestAt',
                       'partnerLocked', 'partnerName', 'partnerEmail', 'updatedAt']);
    }

    // The colleague who changes room so my new partner can take their
    // place. Room only, and only somebody sitting in the room I am in.
    function isRoomSwapBesideMe() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['roomId', 'roomName', 'updatedAt'])
        && exists(myDutyPath(resource.data.date))
        && get(myDutyPath(resource.data.date)).data.roomId == resource.data.roomId;
    }

    function isMyAttendance() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['present', 'markedAt', 'markedBy', 'updatedAt'])
        && resource.data.email == request.auth.token.email.lower()
        && request.resource.data.present != false
        && resource.data.present != false
        && (
             !('startsAt' in resource.data) || resource.data.startsAt == null
             || (
                  request.time.toMillis() >= resource.data.startsAt
                  && request.time.toMillis() <= resource.data.startsAt + 1800000
                )
           );
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    /** My own duty document on a given date, if I have one. */
    function myDutyPath(date) {
      return /databases/$(database)/documents/duties/$(date + '__' + myEmail());
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myProfile().role
        : 'none';
    }

    function isAdmin()   { return myRole() == 'admin'; }
    function canBook()   { return myRole() == 'faculty' || myRole() == 'admin'; }

    // ---------- users ----------
    // Everyone signed in can read profiles (needed to show teacher names).
    // You may only write your own profile, and you may not make yourself
    // an admin or hand yourself faculty rights - an admin does that.
    match /users/{uid} {
      // You can always read yourself. Staff can read everyone, because the
      // Admin -> People screen needs it. Students cannot read other
      // students - a booking already carries the teacher's name, so the
      // board never needs the users collection.
      allow read: if signedIn() && (
           request.auth.uid == uid
        || myRole() == 'faculty'
        || isAdmin()
      );

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['faculty', 'student'];

      allow update: if signedIn() && (
           isAdmin()
        || ( request.auth.uid == uid
             && request.resource.data.role == resource.data.role
             && request.resource.data.email == resource.data.email )
      );

      allow delete: if isAdmin();
    }

    // ---------- rooms / batches / config ----------
    // Read by anyone signed in, changed only by an admin.
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /batches/{batchId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- bookings ----------
    // Anyone signed in can see the board.
    // Faculty create their own bookings; only the owner or an admin
    // may change or remove one.
    // A teacher's own booking must be created unapproved - only an
    // admin signs it off, and only an admin may ever flip `approved`
    // afterwards. Everything else about a booking stays editable by
    // its owner (moving rooms, cancelling), so the rule below pins
    // that one field rather than freezing the whole document.
    match /bookings/{bookingId} {
      allow read: if signedIn();

      allow create: if canBook()
        && ( request.resource.data.facultyUid == request.auth.uid || isAdmin() )
        && request.resource.data.status == 'confirmed'
        && ( isAdmin() || request.resource.data.approved == false );

      allow update, delete: if canBook()
        && ( resource.data.facultyUid == request.auth.uid || isAdmin() )
        && ( isAdmin() || request.resource.data.approved == resource.data.approved );
    }

    // ---------- slotLocks ----------
    // One document per occupied hour, id = <date>_<roomId>_<slot>.
    // Its existence IS the booking conflict guard, so creation must be
    // done inside a transaction by the app. Only faculty touch these.
    match /slotLocks/{lockId} {
      allow read: if signedIn();
      allow create: if canBook()
        && ( request.resource.data.facultyUid == request.auth.uid || isAdmin() );
      allow update, delete: if canBook()
        && ( resource.data.facultyUid == request.auth.uid || isAdmin() );
    }

    // ---------- notices ----------
    // Append-only history. Faculty write, everyone reads, admin prunes.
    match /notices/{noticeId} {
      allow read: if signedIn();
      allow create: if canBook();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- roster ----------
    // Pre-loaded student rows (email -> year/batch, name once it's
    // added), read once by onboarding so a student never has to pick
    // their own batch wrong. Everyone else can only read their OWN row -
    // the same email-ownership check used everywhere else. Admin can
    // additionally read every row, for the "who's in this batch" list
    // on Admin -> Batches. Only an admin (via the seed script's Admin
    // SDK, which bypasses this entirely) ever writes it.
    match /roster/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }

    // ---------- otpCodes ----------
    // The one-time login codes from /api/auth/request-code. Nobody signs
    // in yet when one of these matters, so no client rule could check who
    // "owns" a code anyway - only the server (Admin SDK, which ignores
    // these rules entirely) is ever allowed to touch this collection.
    match /otpCodes/{email} {
      allow read, write: if false;
    }
  
    // ---------- invigilation ----------
    // Everything here is staff-only. Students cannot read a single
    // document in these four collections.
    //
    // Why teachers may write and not only read: a teacher dropping a
    // duty has to hand it to somebody else in the same moment (a new
    // duty document), and accepting a partner moves two other people.
    // Doing that from the browser keeps the app free of a server. What
    // a teacher may write is pinned down below to their own duty, the
    // duty of somebody who asked THEM, and a room swap beside them -
    // nothing else. Deleting is admin-only, always.

    match /invigilators/{email} {
      allow read: if canBook();
      // Counts are worked out from the duty documents themselves, so
      // there are no counters for a teacher to move. Only the exam
      // office edits this list.
      allow update: if isAdmin();
      allow create, delete: if isAdmin();
    }

    match /examDays/{dayId} {
      allow read: if canBook();
      allow write: if isAdmin();
    }

    match /duties/{dutyId} {
      allow read: if canBook();
      // A teacher creates exactly one kind of duty: the replacement
      // handed over when somebody drops out. Everything that could be
      // abused is pinned here rather than trusted to the browser -
      // otherwise any teacher could forge a duty for anybody, on any
      // date, already marked present, which would both fake a
      // register and rig the draw (the draw counts duty documents).
      allow create: if isAdmin() || (
        canBook()
        // The id must be the one the app builds, so a duty can never
        // be duplicated under a second id.
        && dutyId == request.resource.data.date + '__' + request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        // Only on a real exam day.
        && exists(/databases/$(database)/documents/examDays/$(request.resource.data.date))
        // Not in the past: no back-filling duties that never happened.
        && request.resource.data.startsAt is number
        && request.resource.data.startsAt > request.time.toMillis() - 86400000
        // Fresh and unremarkable: no attendance, no pair, no skip.
        && request.resource.data.status == 'assigned'
        && request.resource.data.present == null
        && request.resource.data.markedBy == null
        && request.resource.data.partnerLocked == false
      );
      // Four doors, and no more.
      //
      // 1. Attendance on your OWN duty, present only, during the
      //    exam's first half hour. Open even inside a fixed pair,
      //    or two paired teachers could never say "I'm here".
      // 2. Your own duty: drop it, ask for a partner, answer the
      //    pairing question, ask the office for a swap.
      // 3. The duty of somebody who asked YOU: accept or refuse.
      // 4. The colleague sitting beside you who changes room to make
      //    space for the partner you just accepted - room only.
      //
      // A pair both teachers agreed to is fixed: from then on only an
      // admin can move either of them.
      allow update: if isAdmin()
        || (canBook() && isMyAttendance())
        || (
             canBook()
             && resource.data.partnerLocked != true
             && (isMyOwnDuty() || isAnswerToMyAsker() || isRoomSwapBesideMe())
           );
      allow delete: if isAdmin();
    }

    match /invigLog/{entryId} {
      allow read: if isAdmin();
      // Append only, and signed: nobody can write a line under
      // somebody else's name.
      allow create: if canBook()
        && request.resource.data.byEmail == myEmail();
      allow update, delete: if false;
    }

}
}
